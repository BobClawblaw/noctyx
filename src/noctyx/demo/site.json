   "paths": [
    "/etc",
    "/boot"
   ],
   "exclusions": [
    "common"
   ]
  },
  "dataproxy": {
   "description": "Phase 8: huge append-only datasets (weights, checkpoints, /legal) on their own schedule. Split out because 'system' would otherwise be dominated by them and the nightly window would drift.",
   "paths": [
    "/root",
    "/home",
    "/opt",
    "/workspace",
    "/legal"
   ],
   "exclusions": [
    "common",
    "datasets",
    "per-host"
   ]
  },
  "headdata": {
   "description": "head node only: /storage and /mnt/scratch, the mounts 'system' excludes. Replaced external-tool's backup-root.sh rsync mirror (no --delete: kept every deleted bench run, ~16 TB) on 2026-10-11. Uses /etc/noctyx/exclusions-headdata.conf INSTEAD of the common list, whose /data/** and /mnt/** lines would exclude the profile's own paths.",
